# Copy to .env.local and fill in. Consumed by the /konsultasi chat route and
# `npm run ingest`. Never commit .env.local.

# --- Supabase (server-side, service role — bypasses RLS) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- OpenAI ---
OPENAI_API_KEY=

# Optional overrides (defaults shown).
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small   # 1536 dims — matches migration 0009

# --- Abuse guard rails (defaults shown; see SECURITY.md) ---
# proxy.ts — per-IP request rate limits
# RL_GENERAL_PER_MIN=60
# RL_SENSITIVE_PER_MIN=12
# API_MAX_BODY_BYTES=1048576
# Consultation chat route
# KONSULTASI_PER_IP_PER_10MIN=20
# KONSULTASI_GLOBAL_PER_MIN=120          # process-wide OpenAI call ceiling
# KONSULTASI_GLOBAL_CONCURRENT=8
# E-commerce lead form
# ECOMMERCE_LEAD_PER_10MIN=5
