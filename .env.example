# Copy to .env.local and fill in. Consumed by the /konsultasi chat route and
# `npm run ingest`. Never commit .env.local.

# --- Supabase (server-side, service role — bypasses RLS) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- OpenAI ---
OPENAI_API_KEY=

# Optional overrides (defaults shown).
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small   # 1536 dims — matches migration 0009
